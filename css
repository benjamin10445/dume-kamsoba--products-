* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f5f5;
  color: #222;
}

/* HEADER */

header {
  background: #4b210f;
  color: white;
  text-align: center;
  padding: 30px 15px;
}

header h1 {
  margin: 0;
  font-size: 27px;
}

header p {
  margin: 10px 0 0;
  font-size: 17px;
}

/* PRODUCTS */

.products {
  max-width: 1100px;
  margin: auto;
  padding: 25px 15px;

  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(180px, 1fr));

  gap: 18px;
}

.product {
  background: white;
  border-radius: 15px;
  overflow: hidden;

  box-shadow: 0 3px 12px rgba(0,0,0,0.15);

  transition: transform 0.2s;
}

.product:hover {
  transform: translateY(-5px);
}

.product img {
  width: 100%;
  height: 230px;
  object-fit: cover;
  display: block;
}

.product h2 {
  text-align: center;
  font-size: 17px;
  margin: 14px 8px 18px;
}

/* FOOTER */

footer {
  background: #000;
  color: white;
  text-align: center;

  padding: 25px 10px;

  line-height: 1.7;
  font-weight: bold;
}

/* MOBILE */

@media (max-width: 500px) {

  header h1 {
    font-size: 21px;
  }

  .products {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding: 15px 10px;
  }

  .product img {
    height: 190px;
  }

  .product h2 {
    font-size: 14px;
  }
        }
